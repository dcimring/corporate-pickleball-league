{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "app",
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "app-dev-offline",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_CONVEX_URL=http://127.0.0.1:9",
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "5180"
      ],
      "cwd": "app",
      "port": 5180,
      "autoPort": true
    }
  ]
}
